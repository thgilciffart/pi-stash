{
  "name": "@thgilciffart/pi-stash",
  "version": "0.1.0",
  "description": "Save prompts from Pi chat, browse a searchable stash, and reuse prompts across projects.",
  "type": "module",
  "license": "MIT",
  "author": "thgilciffart",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thgilciffart/pi-stash.git"
  },
  "homepage": "https://github.com/thgilciffart/pi-stash#readme",
  "bugs": "https://github.com/thgilciffart/pi-stash/issues",
  "keywords": ["pi-package", "pi", "pi-extension", "prompts", "stash", "prompt-library"],
  "files": ["src", "docs", "README.md", "LICENSE"],
  "pi": { "extensions": ["./src/index.ts"] },
  "engines": { "node": ">=22.19.0" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "dependencies": { "yaml": "^2.8.1" },
  "overrides": {
    "@earendil-works/pi-coding-agent": { "undici": "^8.12.2" }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^22.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
